# Supabase — مصادقة الأدمن (Authentication → Users) + مفتاح القراءة العام
# نفس القيم متظبطة في Vercel → Project Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# اختياري — webhook يستقبل JSON عند وصول كمية أي صنف لحد التنبيه
LOW_STOCK_WEBHOOK_URL=

# للتطوير المحلي فقط: لو متغيرات Supabase مش موجودة البيانات بتتحفظ في ملف
# DATABASE_FILE=/absolute/path/to/restaurant.json
