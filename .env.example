# غيّر القيم دي في الإنتاج
ADMIN_PIN=1234
SESSION_SECRET=replace-with-a-long-random-secret

# قاعدة بيانات Upstash Redis للإنتاج (اختياري محلياً)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Webhook اختياري يستقبل رسائل نقص المخزون بصيغة JSON
LOW_STOCK_WEBHOOK_URL=

# محلياً فقط؛ الافتراضي data/restaurant.json
# DATABASE_FILE=/absolute/path/to/restaurant.json
