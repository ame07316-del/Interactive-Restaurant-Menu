# Supabase Auth — حساب الأدمن يتعمل من Authentication > Users
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# fallback محلي فقط لو Supabase غير مُعدّ
ADMIN_PIN=1234
SESSION_SECRET=replace-with-a-long-random-secret

# قاعدة بيانات Upstash Redis للإنتاج (اختياري محلياً)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Webhook اختياري يستقبل رسائل نقص المخزون بصيغة JSON
LOW_STOCK_WEBHOOK_URL=

# محلياً فقط؛ الافتراضي data/restaurant.json
# DATABASE_FILE=/absolute/path/to/restaurant.json
