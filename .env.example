# ------------------------------------------------------------------
# Supabase — لازم يكونوا NEXT_PUBLIC_ عشان المتصفح يشوفهم
# في Vercel: نوع المتغير لازم يكون Config (مش Secret) وإلا هيتشالوا من الـ client bundle
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key الجديد (sb_publishable_…) أو anon JWT القديم — الاتنين شغالين
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ⚠️ ممنوع تحط sb_secret_ / service_role هنا — أي متغير NEXT_PUBLIC_ بيتشاف في المتصفح.
# لو المتغيرين دول مش موجودين، الموقع بيشتغل ١٠٠٪ من localStorage (وضع الديمو بالرقم السري).
